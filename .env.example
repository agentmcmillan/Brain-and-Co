# Brain-and-Co Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# === Required ===
POSTGRES_PASSWORD=your_postgres_password_here
MEMENTO_ACCESS_KEY=your_memento_access_key_here
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# === Optional: Embeddings ===
OPENAI_API_KEY=

# === Optional: Cloudflare Tunnel ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DOMAIN=mcp.yourdomain.com

# === Optional: ACME email for TLS certificates ===
ACME_EMAIL=admin@yourdomain.com

# === Optional: Signal Messaging ===
SIGNAL_API_URL=http://localhost:8083
SIGNAL_BOT_NUMBER=
SIGNAL_RECIPIENT=
SIGNAL_SENDER=

# === Optional: Ollama ===
OLLAMA_HOST=http://host.docker.internal:11434

# === Optional: SSH Keys ===
SSH_KEYS_PATH=./ssh-keys

# === Optional: MiroFish ===
MIROFISH_URL=http://localhost:5001

# === Optional: LLM Council ===
OPENROUTER_API_KEY=

# === Deployment ===
DEPLOY_HOST=
DEPLOY_USER=claude
CONTAINER_HOST=localhost
